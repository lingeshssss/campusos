# CampusOS environment variables.
# Copy to .env.local for local development (it is git-ignored). Never commit real values.
# In Vercel, set the same names under Project Settings → Environment Variables.
# Only the two NEXT_PUBLIC_ values are sent to browsers. Never put a secret in a NEXT_PUBLIC_ variable.

# ── Required: Supabase (public browser configuration) ─────────────────────────
# Supabase dashboard → Project Settings → API Keys / Data API. Safe to expose: the publishable key
# cannot read CampusOS tables (RLS on, grants revoked; verify with `pnpm db:check-access`).
# These are inlined at build time: redeploy after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ── Required: database (server-only secrets) ─────────────────────────────────
# Runtime connection used by the app: Supabase "Connect" → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Used only by `pnpm db:migrate` on your computer: Session pooler (port 5432) or the direct connection.
# Not needed in Vercel.
DATABASE_MIGRATION_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Required for Google Calendar; otherwise optional (server-only) ────────────
# Exact canonical origin of this deployment, no trailing path. Calendar OAuth only runs on this origin.
# Local: http://localhost:3000   Production: https://your-domain.example
APP_ORIGIN=http://localhost:3000

# ── Optional: Google Calendar sync (server-only secrets) ──────────────────────
# A Google OAuth "Web application" client used ONLY for Calendar. Its redirect URI is
# APP_ORIGIN + /api/google/oauth/callback. (Google *sign-in* is configured inside Supabase instead.)
# Leave blank to disable Calendar sync; the rest of the app and .ics export keep working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google refresh tokens (AES-256-GCM). Base64 of 32 random bytes:
#   openssl rand -base64 32
# Changing it makes existing Calendar connections unreadable; users must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Optional: AI syllabus parsing (server-only secret) ────────────────────────
# Without a key, syllabus/quick-add parsing uses the built-in basic extractor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
