# Build-time settings for the CampusOS iPhone and Android apps (one bundle; all values here are PUBLIC).
# Copy to mobile/.env.production.local (git-ignored) and fill in. Never put a secret in this file:
# database URLs, Google client secrets, encryption keys and OpenAI keys stay on the Vercel server only.

# Your deployed CampusOS website (the Vercel production origin). The app calls its /api routes.
VITE_API_ORIGIN=https://YOUR-PRODUCTION-DOMAIN

# Same public values as the website's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional sign-in buttons. App Store guideline 4.8: Google sign-in requires Sign in with Apple as well,
# so the build fails if Google is enabled without Apple.
VITE_ENABLE_APPLE_SIGNIN=false
VITE_ENABLE_GOOGLE_SIGNIN=false
# Android only: show "Continue with Google" in the Android app without affecting the iPhone app.
# Needs Google enabled in Supabase and campusos://auth/callback in Supabase's Redirect URLs (ANDROID_RELEASE.md).
VITE_ENABLE_GOOGLE_SIGNIN_ANDROID=false
