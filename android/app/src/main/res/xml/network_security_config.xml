<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Bundled content loads from https://localhost inside the app; every network request
     (CampusOS API, Supabase) uses HTTPS with the system's trusted certificate authorities. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
